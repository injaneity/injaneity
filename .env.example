VITE_GITHUB_OWNER=your-username
VITE_GITHUB_REPO=your-repo
VITE_GITHUB_BRANCH=main

# Server only. Put real values in .env.local, never in a VITE_ variable.
# Register an OAuth app with callback: http://127.0.0.1:4173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
AUTH_ORIGIN=http://127.0.0.1:4173
